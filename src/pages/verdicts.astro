---
import Layout from '../layouts/Layout.astro'
import PostGrid from '../components/PostGrid.astro'
import SectionHeading from '../components/SectionHeading.astro'
import { isReviewPost } from '../lib/post-semantics'
import { CleanAndSort } from '../lib/utils'
import RatingIcon from '~icons/mingcute/star-fill'

const allPosts = await CleanAndSort()
const reviews = allPosts.filter(isReviewPost)
reviews.sort((a, b) => (b.data.rating ?? 0) - (a.data.rating ?? 0))

const withRating = reviews.filter((p) => p.data.rating != null)
const avgRating =
    withRating.length > 0
        ? withRating.reduce((sum, p) => sum + (p.data.rating ?? 0), 0) / withRating.length
        : 0
const winCount = reviews.filter((p) => p.data.mood === 'positive').length
const lessonCount = reviews.filter((p) => p.data.mood === 'neutral').length
const failCount = reviews.filter((p) => p.data.mood === 'negative').length
---

<Layout
    title="Honest Product & Vendor Verdicts for HDB Homes"
    description="Every product and vendor we made a real call on, the wins, the lessons, the regrets, and what we'd actually buy again. No sponsors, no affiliate kickbacks."
>
    <div class="mb-10">
        <SectionHeading level="h1" title="The verdicts" class="mb-4" />
        <p class="text-base-content/65 max-w-2xl text-lg">
            Everything we made a real call on, the stuff worth your money, the lessons, and the
            stuff that wasn't. No sponsors, no affiliate kickbacks, just our own receipts.
        </p>
        <div
            class="ledger text-base-content/55 mt-6 flex flex-wrap items-baseline gap-x-5 gap-y-1.5 text-sm"
        >
            <span>
                <strong class="text-base-content text-lg font-extrabold">{reviews.length}</strong>
                verdicts
            </span>
            <span class="text-ink/20" aria-hidden="true">·</span>
            <span class="inline-flex items-center gap-1">
                <strong class="text-accent-content text-lg font-extrabold">
                    {avgRating.toFixed(1)}
                </strong>
                avg
                <RatingIcon class="text-accent-content h-4 w-4" aria-hidden="true" />
            </span>
            <span class="text-ink/20" aria-hidden="true">·</span>
            <span>
                <strong class="text-secondary text-lg font-extrabold">{winCount}</strong> wins /
                <strong class="text-base-content text-lg font-extrabold">{lessonCount}</strong>
                lessons /
                <strong class="text-primary text-lg font-extrabold">{failCount}</strong> fails
            </span>
        </div>
    </div>

    <PostGrid posts={reviews} sortable filterable defaultSort="rating" id="verdicts" />
</Layout>
